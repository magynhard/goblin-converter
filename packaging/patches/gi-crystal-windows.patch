--- a/src/generator/lib_gen.cr
+++ b/src/generator/lib_gen.cr
@@ -9 +9,7 @@
-        library[/lib([^\/]+)(?:\.so|-.+?\.dll|\..+?\.dylib).*/, 1]
+        if library.ends_with?(".dll")
+          # Remove only the final numeric DLL ABI suffix, keeping names such
+          # as harfbuzz-gobject intact and accepting unversioned harfbuzz.dll.
+          library.sub(/\.dll$/, "").sub(/-\d+$/, "").sub(/^lib/, "")
+        else
+          library[/lib([^\/]+)(?:\.so|\..+?\.dylib).*/, 1]
+        end
--- a/src/generator/helpers.cr
+++ b/src/generator/helpers.cr
@@ -1,1 +1,17 @@
 module Generator::Helpers
+  # Some Windows typelibs report signed storage for unsigned flag values.
+  def enum_base_type(info : EnumInfo) : String
+    if info.storage_type.int32? && info.values.any? { |value| value.value > Int32::MAX }
+      "UInt32"
+    else
+      to_crystal_type(info.storage_type)
+    end
+  end
+
+  # Opaque structs cannot be embedded by value in a Crystal lib struct.
+  def opaque_struct_value?(type : TypeInfo) : Bool
+    return false if type.pointer? || !type.tag.interface?
+    iface = type.interface
+    iface.is_a?(StructInfo) && iface.bytesize.zero?
+  end
+
